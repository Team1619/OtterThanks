# ==============================================================
# OtterThanks Environment Configuration
# ==============================================================

# PostgreSQL Database Credentials
# (Docker Compose automatically strings these together into the database connection string)
POSTGRES_USER=otter
POSTGRES_PASSWORD=otterpass
POSTGRES_DB=otterthanks

# Google Workspace OAuth 2.0 (OIDC) Credentials
# Create these in Google Cloud Console -> APIs & Services -> Credentials
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret
GOOGLE_REDIRECT_URI=http://localhost:8000/api/auth/callback

# Allowed Google Group (Only members of this group are permitted mentor access)
# Examples: mentors@team1619.net or mentors@upacreekrobotics.org
ALLOWED_GOOGLE_GROUP=mentors@team1619.net

# Optional: Direct allowed mentor emails (comma-separated).
# If Google Directory API returns 403 (e.g. non-admin users cannot query directory APIs directly),
# emails listed here will be granted immediate access.
ALLOWED_MENTOR_EMAILS=emilysastranova@team1619.org

# Session Security (Change to a long secure secret in production)
SESSION_SECRET_KEY=change-this-to-a-random-secret-key-in-production

# Development Mode: Set to true to allow quick local mentor login without Google secrets
DEV_MODE=false

# ==============================================================
# Slack Bot Integration
# ==============================================================
# 1. Create a Slack App at https://api.slack.com/apps
# 2. Add OAuth & Permissions Bot Token Scopes: chat:write, chat:write.public
# 3. Install App to Workspace to get the Bot User OAuth Token (starts with xoxb-)
SLACK_BOT_TOKEN=xoxb-your-slack-bot-token

# The Public Slack Channel ID where approved kudos should be posted (e.g. C0123456789)
# To find Channel ID: In Slack, right click the channel name -> View channel details -> Scroll to bottom to copy Channel ID
SLACK_CHANNEL_ID=C0123456789

# The Private Slack Channel ID where new kudos are sent for mentor review with ✅ / ❌ buttons
# Note: Since this channel is private, make sure to invite your bot using: /invite @YourBotName
SLACK_MENTOR_CHANNEL_ID=C9876543210

# Slack Signing Secret (found in Slack App -> Basic Information -> App Credentials -> Signing Secret)
# Used to verify authentic button clicks from Slack's Interactivity webhook.
SLACK_SIGNING_SECRET=your-slack-signing-secret
